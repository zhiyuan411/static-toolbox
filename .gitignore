# 忽略所有文件（包括隐藏文件）
*
.*
file2base64
json
qr


# 但不忽略需要同步的文件夹（用 ! 排除，/** 表示递归包含该目录下所有层级）
!.gitignore
!base64
!base64/**
!code-formatting
!code-formatting/**
!encoding
!encoding/**
!hash
!hash/**
!zip-base64
!zip-base64/**
!diff
!diff/**
!timestamp
!timestamp/**
!ip
!ip/**
!rain
!rain/**
!fontawesome
!fontawesome/**
!md
!md/**
!input
!input/**
!ofd
!ofd/**
!bill2word
!bill2word/**
!github
!github/**


# 全局忽略的常见产物（必须放在上面的 ! 规则之后才会生效，因为后写的规则优先）
__pycache__/
